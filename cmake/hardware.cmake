# menuconfig selection precedes Zephyr board/devicetree processing.
if(DEFINED ASTER_TARGET)
  message(FATAL_ERROR "ASTER_TARGET was removed. Select hardware with tools/firmware.py menuconfig.")
endif()
set(ASTER_USER_CONFIG "${ASTER_ROOT}/config/aster.conf")
if(NOT EXISTS "${ASTER_USER_CONFIG}")
  set(ASTER_USER_CONFIG "${ASTER_ROOT}/config/default.conf")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ASTER_USER_CONFIG}")
file(READ "${ASTER_USER_CONFIG}" selection)
if(NOT selection MATCHES "CONFIG_ASTER_SYSTEM_ZEPHYR=y")
  message(FATAL_ERROR "No supported firmware system selected; run menuconfig")
endif()
file(GLOB hardware_files CONFIGURE_DEPENDS "${ASTER_ROOT}/hardware/*.json")
set(selected_count 0)
foreach(hardware_file ${hardware_files})
  file(READ "${hardware_file}" hardware_json)
  string(JSON symbol GET "${hardware_json}" build kconfig)
  if(selection MATCHES "CONFIG_${symbol}=y")
    math(EXPR selected_count "${selected_count} + 1")
    string(JSON selected_board GET "${hardware_json}" build board)
    string(JSON ASTER_HARDWARE_ID GET "${hardware_json}" public id)
    foreach(field conf overlay)
      string(JSON count LENGTH "${hardware_json}" build ${field})
      math(EXPR last "${count} - 1")
      set(selected_${field} "")
      foreach(index RANGE 0 ${last})
        string(JSON path GET "${hardware_json}" build ${field} ${index})
        list(APPEND selected_${field} "${ASTER_ROOT}/${path}")
      endforeach()
    endforeach()
  endif()
endforeach()
if(NOT selected_count EQUAL 1)
  message(FATAL_ERROR "Select exactly one supported hardware model in menuconfig")
endif()
if(DEFINED BOARD AND NOT BOARD STREQUAL selected_board)
  message(FATAL_ERROR "BOARD conflicts with menuconfig hardware; use tools/firmware.py build")
endif()
set(BOARD "${selected_board}" CACHE STRING "Board selected by menuconfig" FORCE)
set(bridge "${CMAKE_CURRENT_BINARY_DIR}/aster-services.conf")
file(WRITE "${bridge}" "# Generated from config/aster.conf\n")
foreach(feature CAMERA AUDIO WIFI)
  if(selection MATCHES "CONFIG_ASTER_CFG_${feature}=y")
    file(APPEND "${bridge}" "CONFIG_ASTER_${feature}=y\n")
  else()
    file(APPEND "${bridge}" "CONFIG_ASTER_${feature}=n\n")
  endif()
endforeach()
if(selection MATCHES "CONFIG_ASTER_CFG_LAUNCHER=y")
  file(APPEND "${bridge}" "CONFIG_ASTER_SYSTEM_UI_ENABLE=y\nCONFIG_ASTER_LAUNCHER_NATIVE=y\n")
else()
  file(APPEND "${bridge}" "CONFIG_ASTER_SYSTEM_UI_ENABLE=n\nCONFIG_ASTER_LAUNCHER_NATIVE=n\n")
endif()
set(CONF_FILE "${ASTER_ROOT}/prj.conf;${selected_conf};${ASTER_USER_CONFIG};${bridge}")
set(DTC_OVERLAY_FILE "${selected_overlay}")
