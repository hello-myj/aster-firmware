menu "Aster OSPTEK P4 baseboard V1.5 wiring"
config ASTER_P4_BACKLIGHT_GPIO
    int "BACKLIGHT_GPIO"
    range 0 54
    default 20
config ASTER_P4_LCD_RESET_GPIO
    int "LCD_RESET_GPIO"
    range 0 54
    default 5
config ASTER_P4_TOUCH_SCL_GPIO
    int "TOUCH_SCL_GPIO"
    range 0 54
    default 8
config ASTER_P4_TOUCH_SDA_GPIO
    int "TOUCH_SDA_GPIO"
    range 0 54
    default 7
config ASTER_P4_TOUCH_RESET_GPIO
    int "TOUCH_RESET_GPIO"
    range 0 54
    default 6
config ASTER_P4_TOUCH_INT_GPIO
    int "TOUCH_INT_GPIO"
    range 0 54
    default 21
endmenu
config ASTER_APP_WATCHDOG_MS
    int "Maximum duration of a guest lifecycle/event callback (ms)"
    range 100 30000
    default 2000
config ASTER_P4_AUTORUN_DIAGNOSTIC
    bool "Run SD root app.aot/app.wasm diagnostic automatically at boot"
    default n
    help
        Normally boot directly to the desktop. Run the SD root diagnostic
        explicitly with 'aster app diagnostic' when checking the hardware.
config ASTER_P4_AOT_INTERNAL_RESERVE_KB
    int "Internal SRAM left available when allocating AOT code (KiB)"
    range 16 256
    default 64
config ASTER_SIGNATURE_VERIFY
    bool "Verify package signatures"
    default n
config ASTER_SIGNATURE_REQUIRE
    bool "Reject unsigned packages"
    depends on ASTER_SIGNATURE_VERIFY
    default y
config ASTER_VENDOR_PUBKEY
    string "Trusted P-256 public key (130 hexadecimal characters)"
    depends on ASTER_SIGNATURE_VERIFY
    default ""

config ASTER_P4_RGB666_OUTPUT
    bool "Experimental packed RGB666 MIPI output (P4 rev3, RGB888 framebuffer)"
    depends on ESP32P4_REV_MIN_300
    default n
    help
        Use a 675 KiB RGB888 framebuffer, converted by the rev3 DSI bridge
        into packed RGB666 (18 bits/pixel). LVGL and launcher caches use
        RGB888; apps may negotiate native RGB888 drawing or retain RGB565.
        The boot image is reused as a 450 KiB RGB565 capture shadow.
        ESP-IDF 6.0 has no public RGB666 output API; the board applies the
        documented bridge/host register settings before starting video.
        PPA fills and DMA2D copies support the native RGB888 path. Old 565
        apps retain their source precision and use CPU format conversion.
        Run 'aster app color-test' for four gradient rows, upper halves RGB565,
        lower halves RGB666. Tap the screen or use 'aster app stop' to exit.
        Disable this option to return to the validated RGB565 output path.

config ASTER_P4_DUAL_CORE_RENDER
    bool "Split high-color launcher pixel rows across both HP cores"
    depends on ASTER_P4_RGB666_OUTPUT
    default y
    help
        Pin the sole LVGL/VM owner to CPU1 and run independent, cache-line
        separated pixel rows on CPU0. Join before any LVGL task/cache changes.
        The helper owns a 6 KiB stack. LVGL APIs remain single-owner.
config ASTER_P4_TOUCH_I2C_HZ
    int "ST7123 I2C clock (Hz)"
    range 100000 400000
    default 400000
    help
        ST7123 protocol V01.11 supports up to 400 kHz. Use 100000 if a board
        with different wiring/pull-ups requires the reference-example rate.
