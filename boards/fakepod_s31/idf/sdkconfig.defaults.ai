# Streaming TTS returns an upgrade response larger than 1 KiB.
CONFIG_WS_BUFFER_SIZE=4096
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_SNTP_MAXIMUM_STARTUP_DELAY=1000

# Keep AES-GCM accelerated for continuous PCM. Leave more internal memory
# available to DMA and send allocations larger than 4 KiB to PSRAM first.
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_GCM=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
