# Streaming TTS returns an upgrade response larger than 1 KiB.
CONFIG_WS_BUFFER_SIZE=4096
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_SNTP_MAXIMUM_STARTUP_DELAY=1000

# With ASR, chat and TTS sockets active together, S31 AES-DMA bounce
# allocations can fail in fragmented internal SRAM. Use Mbed TLS's
# software implementation of the same AES ciphers in this profile.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
