@@ -167,6 +167,25 @@ config FS_FATFS_MAX_LFN
 	  additional 608 bytes at exFAT enabled.
 	  It should be set 255 to support full featured LFN operations.
 
+config FS_FATFS_UNICODE
+	bool "UTF-8 file names"
+	help
+	  Exchange long file names with the FS API as UTF-8 instead of
+	  converting them to the OEM code page (FS_FATFS_CODEPAGE).
+
+	  FAT stores long names as UTF-16, so a code page that cannot
+	  represent a name makes the conversion fail, and ELM FAT then
+	  discards the long name entirely and reports the 8.3 short name --
+	  on a card written by another OS that is the raw OEM bytes of the
+	  original, which is not text in any encoding the system speaks.
+	  Names outside the code page (CJK on the default 437, for one) are
+	  therefore unreachable: they cannot be listed and cannot be opened.
+
+	  With this enabled names are UTF-8 end to end, and the code page is
+	  left to the 8.3 short names only.
+	  This option affects FF_LFN_UNICODE defined in ffconf.h, inside
+	  ELM FAT module, by setting its value to 2.
+
 endif # FS_FATFS_LFN
 
 config FS_FATFS_CODEPAGE
