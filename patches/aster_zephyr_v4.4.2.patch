+				spi_esp32_bounce_shrink(data, dma_len_rx);
 				return -ENOMEM;
 			}
 		}
@@ -213,6 +287,7 @@ static int IRAM_ATTR spi_esp32_transfer(const struct device *dev)
 			rx_temp = k_calloc(((dma_len_rx << 3) + 31) / 8, sizeof(uint8_t));
 			if (!rx_temp) {
 				LOG_ERR("Error allocating temp buffer Rx");
+				spi_esp32_bounce_shrink(data, dma_len_rx);
 				err = -ENOMEM;
 				goto free;
 			}
@@ -332,12 +407,15 @@ static int IRAM_ATTR spi_esp32_transfer(const struct device *dev)
 	}
 
 	/* send data */
+#if IS_ENABLED(CONFIG_SPI_ESP32_SLEEP_WAIT)
+	k_sem_reset(&data->tx_wait);
+	spi_ll_clear_int_stat(cfg->spi);
+	spi_ll_enable_int(cfg->spi);
+#endif
 	spi_hal_user_start(hal);
 	spi_context_update_tx(&data->ctx, data->dfs, transfer_len_frames);
 
-	while (!spi_hal_usr_is_done(hal)) {
-		/* nop */
-	}
+	SPI_ESP32_WAIT_DONE(dev, hal);
 
 #if defined(SOC_GDMA_SUPPORTED)
 	if (cfg->dma_enabled) {
@@ -381,12 +459,16 @@ static void IRAM_ATTR spi_esp32_isr(void *arg)
 	const struct device *dev = (const struct device *)arg;
 	const struct spi_esp32_config *cfg = dev->config;
 	struct spi_esp32_data *data = dev->data;
+	int ret;
 
+	/* Same trap as the thread-context loop in transceive(): a transfer
+	 * that bails out before advancing the context would otherwise keep
+	 * spi_esp32_transfer_ongoing() true and spin here forever. */
 	do {
-		spi_esp32_transfer(dev);
-	} while (spi_esp32_transfer_ongoing(data));
+		ret = spi_esp32_transfer(dev);
+	} while (!ret && spi_esp32_transfer_ongoing(data));
 
-	spi_esp32_complete(dev, data, cfg->spi, 0);
+	spi_esp32_complete(dev, data, cfg->spi, ret);
 }
 #endif
 
@@ -427,6 +509,11 @@ static int spi_esp32_init(const struct device *dev)
 	const struct spi_esp32_config *cfg = dev->config;
 	struct spi_esp32_data *data = dev->data;
 
+	/* Widest bounce the heap may be asked for; shrinks on failure (see
+	 * spi_esp32_bounce_shrink). The driver struct is not zero-initialised
+	 * by this point in every configure path, so set it here. */
+	data->dma_chunk = SPI_DMA_MAX_BUFFER_SIZE;
+
 	if (!cfg->clock_dev) {
 		return -EINVAL;
 	}
@@ -476,6 +563,24 @@ static int spi_esp32_init(const struct device *dev)
 	}
 #endif
 
+#if IS_ENABLED(CONFIG_SPI_ESP32_SLEEP_WAIT)
+	k_sem_init(&data->tx_wait, 0, 1);
+	spi_ll_disable_int(cfg->spi);
+	spi_ll_clear_int_stat(cfg->spi);
+
+	err = esp_intr_alloc(cfg->irq_source,
+			ESP_PRIO_TO_FLAGS(cfg->irq_priority) |
+			ESP_INT_FLAGS_CHECK(cfg->irq_flags) | ESP_INTR_FLAG_IRAM,
