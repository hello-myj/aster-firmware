diff --git a/drivers/spi/spi_esp32_spim.h b/drivers/spi/spi_esp32_spim.h
index de57186ca9f..fee62cd968e 100644
--- a/drivers/spi/spi_esp32_spim.h
+++ b/drivers/spi/spi_esp32_spim.h
@@ -66,6 +66,19 @@ struct spi_esp32_data {
 	spi_hal_trans_config_t trans_config;
 	uint8_t dfs;
 	uint32_t clock_source_hz;
+	/* Bytes handed to the peripheral per user command. Starts at
+	 * CONFIG_SPI_ESP32_DMA_CHUNK_SIZE and shrinks (never grows back
+	 * within a boot) when the internal-RAM bounce that a non-DMA-capable
+	 * source needs cannot be k_malloc'd at the current size -- see the
+	 * note at the allocation site in spi_esp32_spim.c. */
+	size_t dma_chunk;
+#if IS_ENABLED(CONFIG_SPI_ESP32_SLEEP_WAIT)
+	/* One DMA block is armed, then the submitting thread sleeps here
+	 * until the trans_done ISR gives it. Sized/used for master mode
+	 * only; CS is handled by spi_context around the whole transaction.
+	 */
+	struct k_sem tx_wait;
+#endif
 };
 
