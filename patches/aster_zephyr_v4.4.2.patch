@@ -684,11 +789,20 @@ static int transceive(const struct device *dev,
 	spi_ll_set_int_stat(cfg->spi);
 #else
 
+	/* spi_esp32_transfer() only advances the SPI context once it gets as
+	 * far as clocking a chunk out. Every one of its error paths returns
