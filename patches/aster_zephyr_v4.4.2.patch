diff --git a/drivers/spi/Kconfig.esp32 b/drivers/spi/Kconfig.esp32
index dd3818e7797..3b24e99ee70 100644
--- a/drivers/spi/Kconfig.esp32
+++ b/drivers/spi/Kconfig.esp32
@@ -17,4 +17,31 @@ config SPI_ESP32_INTERRUPT
 	help
 	  Enables interrupt support for ESP32 SPI driver.
 
+config SPI_ESP32_SLEEP_WAIT
+	bool "Sleep (IRQ-backed) while waiting for DMA transfer completion"
+	depends on !SPI_ESP32_INTERRUPT && MULTITHREADING
+	help
+	  The stock master path finishes every DMA block by polling
+	  spi_hal_usr_is_done() in a tight loop, burning the calling
+	  thread's CPU for the whole wire transfer. With this option each
+	  block is armed, the trans_done interrupt is enabled, and the
+	  calling thread sleeps on a semaphore until the block has fully
+	  clocked out. On a single core this frees the CPU for other
+	  threads (e.g. LVGL rendering while a display flush streams),
+	  which polling can never do: the poller holds the core.
+
+config SPI_ESP32_DMA_CHUNK_SIZE
+	int "Max bytes clocked per DMA user command"
+	range 256 16384
+	default 4092
+	help
+	  Bytes handed to the SPI peripheral in a single user_start
+	  command when DMA is enabled. The stock value (4092) equals one
+	  GDMA descriptor, so long buffers are split into many restart
+	  points. Raising it lets one user command feed a whole GDMA
+	  descriptor chain (the GDMA driver auto-splits at 4092 up to
+	  CONFIG_DMA_ESP32_MAX_DESCRIPTOR_NUM entries), cutting per-chunk
+	  restart overhead. The upper bound 16384 keeps k_malloc bounce
+	  spikes off the heap; ms_data_bitlen would allow 32767.
+
 endif # ESP32_SPIM
diff --git a/drivers/spi/spi_esp32_spim.c b/drivers/spi/spi_esp32_spim.c
index 04fd911b65f..471d3f31676 100644
--- a/drivers/spi/spi_esp32_spim.c
+++ b/drivers/spi/spi_esp32_spim.c
@@ -36,16 +36,89 @@ LOG_MODULE_REGISTER(esp32_spi, CONFIG_SPI_LOG_LEVEL);
 #error "spi3 must not have dma-enabled if ADC_ESP32_DMA is enabled for ESP32-S2"
