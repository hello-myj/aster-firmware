diff --git a/dts/bindings/display/sitronix,st7789v.yaml b/dts/bindings/display/sitronix,st7789v.yaml
index 8b582061ed6..05b092b81b3 100644
--- a/dts/bindings/display/sitronix,st7789v.yaml
+++ b/dts/bindings/display/sitronix,st7789v.yaml
@@ -44,7 +44,31 @@ properties:
   mdac:
     type: int
     required: true
-    description: Memory Data Access Control
+    description: |
+      Memory Data Access Control. This is the window the panel comes up in,
+      which is the one width/height describe.
+
+  mdac-alt:
+    type: int
+    description: |
+      Memory Data Access Control for the panel's other window, which lets
+      display_set_orientation() switch between the two at runtime instead of
+      making the window a build-time property.
+
+      MV (0x20) transposes the addressing, so a value differing from `mdac`
+      in MV shows the same rectangle with its edges swapped, and one agreeing
+      in MV shows the same edge lengths (a 180 degree turn of that same
+      window). The alternate window is derived from width/height and never
+      declared: two properties that have to agree is one too many.
+
+      Differing in MV is required, not merely expected: every value of
+      display_orientation is a rotation, so a value that agrees with `mdac`
+      about MV is a mirror of the same rectangle and cannot answer any of
+      them. Since nothing can read it, such a node fails the build instead of
+      accepting a switch that changes no aspect.
+
+      Absent means the driver behaves as upstream - set_orientation() accepts
+      NORMAL only and returns -ENOTSUP for anything else.
 
   lcm:
     type: int
