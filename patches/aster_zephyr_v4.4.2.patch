+	BUILD_ASSERT(!DT_INST_NODE_HAS_PROP(inst, mdac_alt) ||			\
+		ST7789V_ALT_TRANSPOSES(DT_INST_PROP(inst, mdac),		\
+			DT_INST_PROP_OR(inst, mdac_alt, 0)),			\
+		"st7789v: mdac-alt agrees with mdac about MV, so it is a "	\
+		"mirror of the same window and cannot express an orientation");	\
