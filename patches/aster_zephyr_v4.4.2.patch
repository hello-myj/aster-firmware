 		.gamma = DT_INST_PROP(inst, gamma),					\
 		.colmod = DT_INST_PROP(inst, colmod),					\
 		.lcm = DT_INST_PROP(inst, lcm),						\
@@ -505,8 +717,58 @@ static DEVICE_API(display, st7789v_api) = {
 	static struct st7789v_data st7789v_data_ ## inst = {				\
 		.x_offset = DT_INST_PROP(inst, x_offset),				\
 		.y_offset = DT_INST_PROP(inst, y_offset),				\
+		.w_cur = DT_INST_PROP(inst, width),					\
+		.h_cur = DT_INST_PROP(inst, height),					\
+		.mdac_cur = DT_INST_PROP(inst, mdac),					\
 	};										\
 											\
+	/* MJX-PATCH: both declared windows must address frame memory. Checked
+	 * here rather than only in set_orientation() because a DTS that pairs
+	 * MV with the wrong window is a build mistake, and the failure it would
+	 * otherwise cause is garbage on the glass, not an error -- the same
+	 * reason the CS recipe is asserted rather than documented. The alt
+	 * window is the derived one, so there is nothing for a board to keep
+	 * in sync by hand.
+	 *
+	 * The second assertion is not independent of the first when the window
+	 * fills the frame memory: with zero offsets the two candidate windows
+	 * are (w,h) and (h,w) and the two MV states have exactly those limits,
+	 * so whatever the primary accepts the alternate does too (checked by
+	 * enumeration on the reference board's numbers -- zero witnesses). It
+	 * earns its keep on a panel that is SMALLER than the frame memory,
+	 * where an offset can make the swapped window overrun. Both are kept:
+	 * one costs a line and the other is the case nobody tests.*/	\
+	BUILD_ASSERT(ST7789V_WINDOW_IS_LEGAL(DT_INST_PROP(inst, mdac),		\
+			DT_INST_PROP(inst, x_offset), DT_INST_PROP(inst, y_offset),	\
+			DT_INST_PROP(inst, width), DT_INST_PROP(inst, height)),	\
+		"st7789v: mdac and width/height disagree about the window "	\
+		"(MV transposes: 240x320 without it, 320x240 with it)");	\
+	BUILD_ASSERT(!DT_INST_NODE_HAS_PROP(inst, mdac_alt) ||			\
+		ST7789V_WINDOW_IS_LEGAL(DT_INST_PROP_OR(inst, mdac_alt, 0),	\
+			DT_INST_PROP(inst, x_offset), DT_INST_PROP(inst, y_offset),	\
+			ST7789V_ALT_W(DT_INST_PROP(inst, width),		\
+				DT_INST_PROP(inst, height),			\
+				DT_INST_PROP(inst, mdac),			\
+				DT_INST_PROP_OR(inst, mdac_alt, 0)),		\
+			ST7789V_ALT_H(DT_INST_PROP(inst, width),		\
+				DT_INST_PROP(inst, height),			\
+				DT_INST_PROP(inst, mdac),			\
+				DT_INST_PROP_OR(inst, mdac_alt, 0))),		\
+		"st7789v: mdac-alt cannot show this panel's other window "	\
+		"(check mdac-alt's MV bit against width/height)");		\
