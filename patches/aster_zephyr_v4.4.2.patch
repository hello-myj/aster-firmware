@@ -486,6 +696,8 @@ static DEVICE_API(display, st7789v_api) = {
 		.vrh_value = DT_INST_PROP_OR(inst, vrhs, 0),				\
 		.vdv_value = DT_INST_PROP_OR(inst, vdvs, 0),				\
