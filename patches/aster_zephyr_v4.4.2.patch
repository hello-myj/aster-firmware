+#if IS_ENABLED(CONFIG_ST7789V_CS_ASSERT_AFTER_RESET)
+/* Official LCKFB sequence: reset (with CS edges), then lcd_cs(0) and
+ * never let the SPI driver touch CS again. DC still selects cmd/data.
+ *
+ * Keep hardware CS disabled: ESP32 SPIM maps !cs_is_gpio to CS0/1/2 via
+ * spi_config.slave. slave > 2 is the HAL "no CS pin" equivalent of
+ * GPIO_NUM_NC. */
+static void st7789v_cs_park_low(struct st7789v_data *data)
+{
+	if (!spi_cs_is_gpio(&data->dbi.config) ||
+	    data->dbi.config.cs.gpio.port == NULL) {
+		return;
+	}
+
+	(void)gpio_pin_set_dt(&data->dbi.config.cs.gpio, 1);
+	data->dbi.config.cs.cs_is_gpio = false;
+	data->dbi.config.cs.gpio.port = NULL;
+	data->dbi.config.slave = 0xFF;
+	LOG_INF("cs parked low after reset (SPI will not toggle it)");
+}
+#endif
+
