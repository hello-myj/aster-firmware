+		 * pixel traffic can keep CS low; DC still distinguishes
+		 * command vs data. */
+		if ((data->dbi.config.operation & SPI_HOLD_ON_CS) == 0) {
+			data->dbi.config.operation |= SPI_HOLD_ON_CS;
+			LOG_INF("hold-cs armed after DISPON");
+		}
+	}
+#endif
+	return ret;
 }
 
