+/* MJX-PATCH: frame memory is 240 (native X) by 320 (native Y), and MADCTL's
+ * MV bit (0x20) transposes the counters, which is why the same controller can
+ * present either a 240x320 or a 320x240 window. A window that does not match
+ * the current MV asks CASET or RASET for an address the controller does not
+ * have there: it wraps into the rest of frame memory (visible garbage) rather
+ * than failing. One predicate, used by the build-time assertions and by
+ * set_orientation(), so the two can never disagree about what "legal" means.
+ *
+ * Offsets are added in because set_mem_area() adds them: the check has to be
+ * on the address that actually reaches the controller. */
+#define ST7789V_GRAM_X 240u /* native columns */
+#define ST7789V_GRAM_Y 320u /* native rows */
+#define ST7789V_MADCTL_MV 0x20u
+
+/* Both of the next two are macros rather than functions on purpose: they are
+ * wanted in BUILD_ASSERTs as well, and _Static_assert needs an integer
+ * constant expression, which a function call never is. Same reason the
+ * predicate carries the offsets: set_mem_area() adds them, so the address
+ * that reaches the controller is the one that has to be checked. */
+#define ST7789V_WINDOW_IS_LEGAL(mdac, xo, yo, w, h)			\
+	(((uint32_t)(xo) + (w) <= ((mdac) & ST7789V_MADCTL_MV		\
+					? ST7789V_GRAM_Y : ST7789V_GRAM_X)) && \
+	 ((uint32_t)(yo) + (h) <= ((mdac) & ST7789V_MADCTL_MV		\
+					? ST7789V_GRAM_X : ST7789V_GRAM_Y)))
+
+/* MV only transposes, so a MADCTL value that differs in MV shows the same
+ * rectangle with its edges swapped; one that agrees in MV shows the same edge
+ * lengths (a 180 degree turn, or a mirror of the same rectangle). */
+#define ST7789V_ALT_TRANSPOSES(mdac, mdac_alt)				\
+	((((mdac) ^ (mdac_alt)) & ST7789V_MADCTL_MV) != 0)
+#define ST7789V_ALT_W(w, h, mdac, mdac_alt)				\
+	(ST7789V_ALT_TRANSPOSES(mdac, mdac_alt) ? (h) : (w))
+#define ST7789V_ALT_H(w, h, mdac, mdac_alt)				\
+	(ST7789V_ALT_TRANSPOSES(mdac, mdac_alt) ? (w) : (h))
+
