--- a/drivers/display/Kconfig.st7789v
+++ b/drivers/display/Kconfig.st7789v
@@ -28,3 +28,31 @@ config ST7789V_RGB565X
 	bool "RGB565X"
 
 endchoice
+
+config ST7789V_HOLD_CS_AFTER_INIT
+	bool "Hold SPI CS after the first DISPON"
+	depends on ST7789V
+	help
+	  After a successful display_blanking_off (DISPON), set SPI_HOLD_ON_CS
+	  on a RAM copy of the MIPI DBI SPI config so later CASET/RASET/RAMWR
+	  transfers do not deassert chip-select.
+
+	  Do not use the DTS mipi-hold-cs property for this: that flag is
+	  present from the first command, and this controller's init sequence
+	  needs a CS edge to latch SLPOUT/DISPON (glass stays dark, SPI still
+	  reports success). Holding only after DISPON keeps init working.
+
+	  Intended for boards whose LCD CS sits on a slow I2C expander. The
+	  LCD must be the only device on that SPI bus, because CS then stays
+	  low for the rest of the session.
+
+config ST7789V_CS_ASSERT_AFTER_RESET
+	bool "Park CS low after reset (SPI stops toggling it)"
+	depends on ST7789V
+	help
+	  LCKFB official recipe: after panel reset, assert chip-select once
+	  and take it away from the SPI driver (equivalent to GPIO_NUM_NC).
+	  Later init commands and pixel writes rely on DC only.
+
+	  Reset still uses the normal CS edges (software reset needs them).
+	  This is not DTS mipi-hold-cs, which would also cover reset.
