+/* MJX-PATCH: which MADCTL value and window a request maps to.
+ *
+ * NORMAL is the window the DT declares; ROTATED_90/270 is the panel's other
+ * one (mdac-alt), with its edges swapped. 90 and 270 are the same window here
+ * and not two: which of the pair a rotation by +90 versus -90 lands on is a
+ * mirror difference, and the caller has already chosen which mirror it wants
+ * by choosing mdac-alt. A 180 degree turn would need a third MADCTL value, so
+ * it stays unimplemented.
+ *
+ * Scalar arguments and no logging on purpose: this is the one part of the
+ * patch that can be checked without a board, and it is worth checking because
+ * the two ends are written from opposite directions -- a caller asks for an
+ * ASPECT and this answers with a window, so an inversion between them looks
+ * like a switch that works and turns the wrong way. */
+static int st7789v_window_for(uint8_t mdac, uint8_t mdac_alt, bool switchable,
+			      uint16_t width, uint16_t height,
+			      enum display_orientation orientation,
+			      uint8_t *out_mdac, uint16_t *out_w, uint16_t *out_h)
+{
+	if (orientation == DISPLAY_ORIENTATION_NORMAL) {
+		*out_mdac = mdac;
+		*out_w = width;
+		*out_h = height;
+		return 0;
+	}
+	if (orientation != DISPLAY_ORIENTATION_ROTATED_90 &&
+	    orientation != DISPLAY_ORIENTATION_ROTATED_270) {
+		return -ENOTSUP;
+	}
+	if (!switchable) {
+		return -ENOTSUP;
+	}
+	/* Every orientation in Zephyr's enum is a ROTATION, and turning a
+	 * window a quarter turn has to change MV. An mdac-alt agreeing with
+	 * mdac in MV describes the same rectangle mirrored: accepting the
+	 * request would write the register, change nothing about the aspect,
+	 * and return 0 -- so a caller that asked for an orientation would be
+	 * told it got one while looking at the same shape as before. (A 180
+	 * is this same case plus a turn, which is why it is separately
+	 * unimplemented rather than routed here.) */
+	if (!ST7789V_ALT_TRANSPOSES(mdac, mdac_alt)) {
+		return -ENOTSUP;
+	}
+	*out_mdac = mdac_alt;
+	*out_w = ST7789V_ALT_W(width, height, mdac, mdac_alt);
+	*out_h = ST7789V_ALT_H(width, height, mdac, mdac_alt);
+	return 0;
+}
+
 static int st7789v_set_orientation(const struct device *dev,
 			    const enum display_orientation orientation)
 {
-	if (orientation == DISPLAY_ORIENTATION_NORMAL) {
+	const struct st7789v_config *config = dev->config;
+	struct st7789v_data *data = dev->data;
+	uint16_t w, h;
+	uint8_t mdac;
+	uint8_t tmp;
+	int ret;
+
+	ret = st7789v_window_for(config->mdac, config->mdac_alt,
+				 config->mdac_switchable, config->width,
+				 config->height, orientation, &mdac, &w, &h);
+	if (ret < 0) {
+		const char *why;
+
+		if (!config->mdac_switchable) {
+			why = "no mdac-alt on this panel";
+		} else if (!ST7789V_ALT_TRANSPOSES(config->mdac,
+						   config->mdac_alt)) {
+			why = "mdac-alt does not transpose the window";
+		} else {
+			why = "180 needs a third MADCTL value";
+		}
+		LOG_ERR("Orientation %d not implemented (%s)", (int)orientation,
+			why);
+		return ret;
+	}
+
+	if (!ST7789V_WINDOW_IS_LEGAL(mdac, data->x_offset, data->y_offset, w,
+				     h)) {
+		LOG_ERR("Refusing orientation %d: MADCTL 0x%02x with a %ux%u "
+			"window at offset %u,%u runs past frame memory (%ux%u)",
+			(int)orientation, mdac, w, h, data->x_offset,
+			data->y_offset, ST7789V_GRAM_X, ST7789V_GRAM_Y);
+		return -EINVAL;
+	}
+
+	if (mdac == data->mdac_cur) {
 		return 0;
 	}
-	LOG_ERR("Changing display orientation not implemented");
-	return -ENOTSUP;
+
+	tmp = mdac;
+	ret = st7789v_transmit(dev, ST7789V_CMD_MADCTL, &tmp, 1);
+	if (ret < 0) {
+		return ret;
+	}
+	/* Only after the controller agreed: everything downstream sizes itself
+	 * from get_capabilities(), so advertising the new window first would
+	 * have callers lay out for a window that is not on the glass yet. */
+	data->mdac_cur = mdac;
+	data->w_cur = w;
+	data->h_cur = h;
+	return 0;
 }
 
