-#define SPI_DMA_MAX_BUFFER_SIZE 4092
+#define SPI_DMA_MAX_BUFFER_SIZE CONFIG_SPI_ESP32_DMA_CHUNK_SIZE
+
+/* Floor the adaptive chunk size settles at. One GDMA descriptor is 4092 B,
+ * so below that a chunk buys no restart saving at all while still costing
+ * an extra IRQ-backed wait per block: stop there.
+ */
+#define SPI_DMA_MIN_BUFFER_SIZE 4092u
+
+/* Stock behaviour is a tight poll on the user-done bit: the calling thread
+ * holds the core for the whole wire transfer. With SPI_ESP32_SLEEP_WAIT the
+ * trans_done interrupt gives a semaphore instead, so other threads run while
+ * SPI clocks out (single-core display pipeline: render overlaps flush). The
+ * Kconfig gate (!SPI_ESP32_INTERRUPT) keeps this wait in thread context.
+ */
+#if IS_ENABLED(CONFIG_SPI_ESP32_SLEEP_WAIT)
+#define SPI_ESP32_WAIT_DONE(dev, hal) spi_esp32_sleep_wait_done(dev)
+#else
+#define SPI_ESP32_WAIT_DONE(dev, hal)                                                            \
+	while (!spi_hal_usr_is_done(hal)) {                                                      \
+		/* nop */                                                                        \
+	}
+#endif
 
 #define SPI_DMA_RX 0
 #define SPI_DMA_TX 1
 
+/* Halve the per-command chunk after the internal-RAM bounce that a
+ * non-DMA-capable source needs could not be k_malloc'd.
+ *
+ * This is the coupling that brought `mjx.player` (37 KB of AOT text) up to a
+ * frozen panel: WAMR allocates AOT code from the same 64 KB kernel heap, so
+ * the 16 KB bounce a full-screen PSRAM present asks for stopped fitting
+ * while the app itself was running perfectly well. Failing the transfer
+ * instead of shrinking drops the frame forever -- the panel keeps whatever
+ * it last managed to write and the app reads as hung.
+ *
+ * Shrinking costs wire throughput (fewer bytes per user command, more GDMA
+ * restarts -- see the Kconfig help), which is the right trade: a slower
+ * screen beats a dead one. It only ever shrinks, and only after an
+ * allocation has already failed, so a boot that never runs a large app
+ * never pays for it.
+ */
+static void spi_esp32_bounce_shrink(struct spi_esp32_data *data, size_t want)
+{
+	size_t prev = data->dma_chunk;
+
+	if (prev <= SPI_DMA_MIN_BUFFER_SIZE) {
+		return;
+	}
+	data->dma_chunk = MAX(prev / 2u, SPI_DMA_MIN_BUFFER_SIZE);
+	LOG_WRN("no room for a %u B bounce; SPI chunk %u -> %u B for this boot",
+		(unsigned)want, (unsigned)prev, (unsigned)data->dma_chunk);
+}
+
 static bool spi_esp32_transfer_ongoing(struct spi_esp32_data *data)
 {
 	return spi_context_tx_on(&data->ctx) || spi_context_rx_on(&data->ctx);
 }
 
+#if IS_ENABLED(CONFIG_SPI_ESP32_SLEEP_WAIT)
+/* One per-block completion interrupt: trans_done fires when the whole
+ * user command (all GDMA descriptors of the chunk) has clocked out. Mask
+ * and clear before waking the submitter so the next block re-arms clean.
+ */
+static void IRAM_ATTR spi_esp32_sleep_isr(const void *arg)
+{
+	const struct device *dev = (const struct device *)arg;
+	const struct spi_esp32_config *cfg = dev->config;
+	struct spi_esp32_data *data = dev->data;
+
+	spi_ll_disable_int(cfg->spi);
+	spi_ll_clear_int_stat(cfg->spi);
+	k_sem_give(&data->tx_wait);
+}
+
+static void spi_esp32_sleep_wait_done(const struct device *dev)
+{
+	struct spi_esp32_data *data = dev->data;
+
+	k_sem_take(&data->tx_wait, K_FOREVER);
+}
+#endif
