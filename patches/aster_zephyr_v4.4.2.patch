+	size_t dma_len_tx = MIN(ctx->tx_len * data->dfs, max_buf_sz);
+	size_t dma_len_rx = MIN(ctx->rx_len * data->dfs, max_buf_sz);
 	bool prepare_data = true;
 	int err = 0;
 
@@ -189,6 +261,7 @@ static int IRAM_ATTR spi_esp32_transfer(const struct device *dev)
 			tx_temp = k_malloc(dma_len_tx);
 			if (!tx_temp) {
 				LOG_ERR("Error allocating temp buffer Tx");
+				spi_esp32_bounce_shrink(data, dma_len_tx);
