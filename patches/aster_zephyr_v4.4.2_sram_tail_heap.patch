diff --git a/lib/libc/common/source/stdlib/malloc.c b/lib/libc/common/source/stdlib/malloc.c
index 74193fbdce4..65e9883d812 100644
--- a/lib/libc/common/source/stdlib/malloc.c
+++ b/lib/libc/common/source/stdlib/malloc.c
@@ -233,6 +233,17 @@ static int malloc_prepare(void)
 	z_malloc_partition.attr = K_MEM_PARTITION_P_RW_U_RW;
 #endif
 
+	/* ESP32 moves the kernel heap to the front of this same tail.
+	 * Other SoCs report a zero reserve. */
+	extern size_t z_sys_heap_sram_tail_reserve(void);
+	size_t reserve = z_sys_heap_sram_tail_reserve();
+
+	if (reserve != 0) {
+		__ASSERT(heap_size > reserve, "SRAM tail cannot hold the kernel heap");
+		heap_base = (char *)heap_base + reserve;
+		heap_size -= reserve;
+	}
+
 	sys_heap_init(&z_malloc_heap, heap_base, heap_size);
 
 	return 0;
