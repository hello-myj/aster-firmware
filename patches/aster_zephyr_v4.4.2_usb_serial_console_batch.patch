+/* Delay after which bytes that have not ended a line are flushed to the
+ * endpoint. A flush (wr_done) hands the TX FIFO to the USB endpoint, which
+ * then needs a hardware turnaround before the next byte can be accepted;
+ * measured on the ESP32-S3 that turnaround is ~80us per flush, so the
+ * flush-per-character this driver used to do made every byte of console
+ * output cost that much - a formatted log line is ~140 bytes, i.e. ~10ms of
+ * stall for the thread that emitted it (with immediate-mode logging that is
+ * whichever thread logged, including a render loop). Bytes now accumulate
+ * in the 64-byte TX FIFO, which the hardware flushes on its own when full;
+ * this timer only exists so text without a newline (shell prompts,
+ * character echo) still reaches the host promptly. */
+#define USBSERIAL_TAIL_FLUSH_DELAY_US 250
+#define USBSERIAL_FLUSH_RETRY_LIMIT 20
+
+static void serial_esp32_usb_flush_timer_expiry(struct k_timer *timer)
+{
+	struct serial_esp32_usb_data *data =
+		CONTAINER_OF(timer, struct serial_esp32_usb_data, tx_flush_timer);
+
+	/* Serialize flush against writable-check + write. A timer interrupt in
+	 * that gap can hand the FIFO to USB and silently lose the next byte. */
+	k_spinlock_key_t key = k_spin_lock(&data->tx_lock);
+	if (!usb_serial_jtag_ll_txfifo_writable()) {
+		/* A previously written packet is still in flight (the FIFO
+		 * auto-flushes at its 64-byte boundary). Wait for it, both
+		 * to deliver a pending tail and, when the output ended
+		 * exactly on that boundary, to send the zero-length packet
+		 * that completes the host transaction - see the flush note
+		 * in usb_serial_jtag_ll.h. Bounded: if the host has stopped
+		 * draining entirely there is nothing more to do here. */
+		if (data->tx_flush_retries++ < USBSERIAL_FLUSH_RETRY_LIMIT) {
+			k_timer_start(timer, K_USEC(USBSERIAL_TAIL_FLUSH_DELAY_US), K_NO_WAIT);
+		}
+		k_spin_unlock(&data->tx_lock, key);
+		return;
+	}
+	data->tx_flush_retries = 0;
+	usb_serial_jtag_ll_txfifo_flush();
+	k_spin_unlock(&data->tx_lock, key);
+}
+
 static void serial_esp32_usb_poll_out(const struct device *dev, unsigned char c)
 {
 	struct serial_esp32_usb_data *data = dev->data;
@@ -72,15 +116,36 @@ static void serial_esp32_usb_poll_out(const struct device *dev, unsigned char c)
 	 * If there is no USB host connected, this function will busy-wait once for the timeout
 	 * period, but return immediately for subsequent calls.
 	 */
-	do {
+	for (;;) {
+		k_spinlock_key_t key = k_spin_lock(&data->tx_lock);
 		if (usb_serial_jtag_ll_txfifo_writable()) {
 			usb_serial_jtag_ll_write_txfifo(&c, 1);
-			usb_serial_jtag_ll_txfifo_flush();
+			/* End of line (and ISR context, where a timer would
+			 * only postpone the same work): flush synchronously.
+			 * Anything else leaves the tail to the timer. */
+			if (c == '\n' || k_is_in_isr()) {
+				k_timer_stop(&data->tx_flush_timer);
+				usb_serial_jtag_ll_txfifo_flush();
+			} else {
+				data->tx_flush_retries = 0;
+				k_timer_start(&data->tx_flush_timer,
+					      K_USEC(USBSERIAL_TAIL_FLUSH_DELAY_US), K_NO_WAIT);
+			}
 			data->last_tx_time = k_uptime_get();
+			k_spin_unlock(&data->tx_lock, key);
+			return;
+		}
+		/* Decide timeout alongside the failed FIFO check. If we unlock first,
+		 * a long GUI/TLS preemption can make the old wall-clock loop expire
+		 * even though the FIFO became writable while we were off CPU. */
+		int64_t now = k_uptime_get();
+		bool expired = (now - start_time) >= USBSERIAL_POLL_OUT_TIMEOUT_MS ||
+			       (now - data->last_tx_time) >= USBSERIAL_POLL_OUT_TIMEOUT_MS;
+		k_spin_unlock(&data->tx_lock, key);
+		if (expired) {
 			return;
 		}
-	} while ((k_uptime_get() - start_time) < USBSERIAL_POLL_OUT_TIMEOUT_MS &&
-		 (k_uptime_get() - data->last_tx_time) < USBSERIAL_POLL_OUT_TIMEOUT_MS);
+	}
 }
 
