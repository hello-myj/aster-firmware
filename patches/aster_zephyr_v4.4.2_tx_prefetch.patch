 	  Send 64-byte aligned/multiple PSRAM TX buffers through GDMA directly.
 	  Flush CPU cache before DMA; other buffers retain the bounce path.
 
+config SPI_ESP32_TX_PREFETCH
+	bool "ESP32-S3 bounded TX DMA lookahead copy"
+	depends on SOC_SERIES_ESP32S3 && SPI_ESP32_SLEEP_WAIT && DMA
+	default n
+	help
+	  Opt-in per-device via spi_esp32_tx_prefetch_set. TX-only single-buffer
+	  PSRAM transfers use two internal buffers with a total budget no larger
+	  than the existing DMA chunk ceiling. Copy the next band while the
+	  previous band is on the wire; fall back before transmission if allocation
+	  fails. RX, fragmented buffers and short transfers retain the old path.
+
+config SPI_ESP32_TX_PREFETCH_LARGE_BANDS
+	bool "Use two up-to-16 KiB internal TX prefetch bands"
+	depends on SPI_ESP32_TX_PREFETCH
+	default n
+	help
+	  Double the staging band size and allocation budget, without raising
+	  the DMA command ceiling. At the 16 KiB ceiling this allocates 32 KiB
+	  instead of 16 KiB. Requires sufficient internal heap; adaptive chunk
+	  shrinking also shrinks the pair. Allocation failure retains old bounce.
+
 config SPI_ESP32_DMA_CHUNK_SIZE
 	int "Max bytes clocked per DMA user command"
 	range 256 16384
