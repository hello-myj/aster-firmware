+/* Internal port diagnostics: actual HAL-calculated clock, not request Hz. */
+uint32_t spi_esp32_effective_hz(const struct device *dev)
+{
+ struct spi_esp32_data *data=dev->data;
+ return data->dev_config.timing_conf.real_freq;
+}
+int spi_esp32_tx_prefetch_set(const struct device *dev,bool enabled)
+{
+#if IS_ENABLED(CONFIG_SPI_ESP32_TX_PREFETCH)
+ struct spi_esp32_data *data=dev->data;
+ /* Caller owns its dedicated panel device and has drained all transfers. */
+ if(data->tx_stages) return -EBUSY;
+ data->tx_prefetch_enabled=enabled;return 0;
+#else
+ return enabled?-ENOTSUP:0;
+#endif
+}
